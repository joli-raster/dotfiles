{
  "reload_style_on_change": true,
  "layer": "top",
  "position": "top",
  "spacing": 20,
  "margin": 15,
  "modules-left": ["custom/menu", "niri/workspaces"],
  "modules-center": [ "niri/window" ],
  "modules-right": [ 
    "group/ctl",
    "clock",
  ],
  "custom/menu": {
    "format": "󰣇",
    "on-click": "fuzzel",
  },
  "cpu": {
    "interval": 1,
    "format": "󰍛 {usage}%",
    "on-click": "foot btop"
  },
    "clock": { 
        "format": " {:%I:%M %p}",
        "format-alt": "{:%A | %e %B}",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>"
     },
  "network": {
    "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
    "format": "{icon}",
    "format-wifi": "{icon}",
    "format-ethernet": "󰀂",
    "format-disconnected": "󰤮",
    "tooltip-format-wifi": "{essid} ({frequency} GHz)\n⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
    "tooltip-format-ethernet": "⇣{bandwidthDownBytes}  ⇡{bandwidthUpBytes}",
    "tooltip-format-disconnected": "Disconnected",
    "interval": 3,
    "spacing": 1,
    "on-click": "foot nmtui"
  },
  "bluetooth": {
    "format": "",
    "format-disabled": "󰂲",
    "format-connected": "󰂱",
    "format-no-controller": "",
    "tooltip-format": "Devices connected: {num_connections}",
    "on-click": "foot bluetui"
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "on-click": "foot alsamixer",
    "tooltip-format": "Playing at {volume}%",
    "scroll-step": 5,
    "format-muted": "",
    "format-icons": {
      "default": [
        "",
        " ",
        " "
      ]
    }
  },
  
  "group/tray-expander": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 600,
      "children-class": "tray-group-item"
    },
    "modules": ["custom/expand-icon", "tray"]
  },

  "tray": {
    "icon-size": 12,
    "spacing": 4
  },

  "mpris": {
	"interval": 10,
	"format": "{player_icon} {dynamic}",
	"format-paused": "{status_icon} {artist} {title}",
	"on-click-middle": "playerctl play-pause",
	"on-click": "playerctl previous",
	"on-click-right": "playerctl next",
	"scroll-step": 5.0,
	"smooth-scrolling-threshold": 1,
	"tooltip": true,
	"tooltip-format": "{status_icon} {dynamic}\nLeft Click: previous\nMid Click: Pause\nRight Click: Next",
	"player-icons": {
		"default": "",
		"firefox": "",
		"mpv": "󰐹",
		"vlc": "󰕼",
	},
	"status-icons": {
		"paused": "",
		"playing": "",
		"stopped": "",
	},
	"dynamic-order": ["artist", "title"],
	"ignored-players": ["firefox", "zen"],
	"max-length": 40,
 },
  "custom/separator#blank": {
	  "format": " ",
	  "interval": "once",
	  "tooltip": false
},

"niri/window": {
    "format": "{title}",
    "max-length": 100,
    "rewrite": {
      " - ": "", // if no window is focused, a single dash is displayed, this removes it
      "(.*nvim)...(.*)": "   $2 ",
      "^.*btop( .*|$)": " 󰧨 BTOP $1 ",
      "(.*) - foot": "   $1 ",
      "(.*Steam)...(.*)": "   $1",
    }
  },

  "group/ctl": {
	"orientation": "inherit",
	"modules": [
    "custom/screenrecording-indicator", 
    "custom/separator#blank",
    "bluetooth",
    "network",
    "pulseaudio",
    "cpu",
    "battery",
	]
},

  "custom/bt": {
    "format": "",
  }
},
